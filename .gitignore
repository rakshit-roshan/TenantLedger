# ==============================================================================
# Gharkhata Root .gitignore
# Multi-Tenant Rent Management Platform (Spring Boot 3 + React 18 / Vite + MySQL)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Local Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
!.env.example

# ------------------------------------------------------------------------------
# 2. Node & Frontend Build Artifacts (React + Vite + TypeScript)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.vite/
frontend/.vite/
.eslintcache
.stylelintcache
coverage/

# ------------------------------------------------------------------------------
# 3. Java & Maven Build Artifacts (Spring Boot)
# ------------------------------------------------------------------------------
target/
backend/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Android build outputs & Gradle caches
.gradle/
android/.gradle/
android/build/
android/app/build/
*.ap_
*.aab
!build-output/Gharkhata.apk

# Maven error dumps & crash logs
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# 4. Logs & Diagnostics
# ------------------------------------------------------------------------------
*.log
logs/
frontend/logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. IDEs & Code Editors
# ------------------------------------------------------------------------------
# JetBrains (IntelliJ IDEA, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# Sublime Text / Atom
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# 6. Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 7. Temporary, Swap & Backup Files
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

