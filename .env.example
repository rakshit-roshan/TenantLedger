# ==============================================================================
# Gharkhata Centralized Environment Configuration Template
# Copy this file to .env and configure your local settings
# ==============================================================================

# Application Branding
APP_NAME=Gharkhata
APP_DISPLAY_NAME=Gharkhata (घरखाता)
APP_DESCRIPTION=Multi-Tenant Rent Management Platform for India
VITE_APP_NAME=Gharkhata
VITE_APP_DISPLAY_NAME=Gharkhata (घरखाता)

# Server Ports
SERVER_PORT=8080
FRONTEND_PORT=5173
VITE_PORT=5173

# Context Path & API Endpoints
SERVER_CONTEXT_PATH=/api/v1
API_BASE_URL=/api/v1
VITE_API_BASE_URL=/api/v1

# Service URLs
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
VITE_BACKEND_URL=http://localhost:8080
VITE_FRONTEND_URL=http://localhost:5173

# Database Connection (MySQL 8.0/8.4)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gharkhata
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Security & JWT Configuration
# Generate a secure 256-bit secret key for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

